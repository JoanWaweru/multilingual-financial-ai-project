# Copy to .env and fill in real values (never commit .env)

# HuggingFace (model downloads / training)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Reddit data collection (optional)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=multilingual-financial-ai/0.1 by your_reddit_username

# Anthropic (full-stack backend chat)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Legacy / optional
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
OPENAI_API_KEY=your_openai_api_key_here

# Project settings
PROJECT_NAME=multilingual_finance_ai_chatbot
ENVIRONMENT=development

# Paths (optional — defaults in config/settings.py)
DATA_DIR=data
MODELS_DIR=saved_models
LOGS_DIR=logs
